<Project>
  <!--
    The Razor SDK consumes *.razor as a `RazorComponent` item, not as source text visible to
    Roslyn source generators. RouteGen's Blazor page-route generator (RouteGen.PathsGenerator)
    reads `@page` directives via AdditionalFiles, so we add *.razor here. This is a no-op for
    non-Blazor consuming projects (Server), since the glob simply matches nothing.

    Set <RouteGenIncludeRazorFiles>false</RouteGenIncludeRazorFiles> in the consuming project
    to opt out (e.g. if you already add *.razor as AdditionalFiles yourself, which would
    otherwise cause duplicate-item warnings).
  -->
  <PropertyGroup>
    <RouteGenIncludeRazorFiles Condition="'$(RouteGenIncludeRazorFiles)' == ''">true</RouteGenIncludeRazorFiles>
  </PropertyGroup>

  <ItemGroup Condition="'$(RouteGenIncludeRazorFiles)' == 'true'">
    <AdditionalFiles Include="**/*.razor" Exclude="**/bin/**/*.razor;**/obj/**/*.razor" />
  </ItemGroup>
</Project>

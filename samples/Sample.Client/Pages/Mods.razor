@page "/"
@inject IModsApi ModsApi

<PageTitle>Mods</PageTitle>

<h1>Mods</h1>

@if (_result is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <ul>
        @foreach (var mod in _result.Items)
        {
            <li>
                <NavLink href="@Paths.ModDetail(mod.Id)">@mod.Name</NavLink> by @mod.Author
            </li>
        }
    </ul>
    <p>@_result.TotalCount total mod(s).</p>
}

@code {
    private ModListResult? _result;

    protected override async Task OnInitializedAsync()
    {
        // No HttpClient, no URL strings — just a plain typed method call. The route/verb/params
        // are guaranteed to match the server's [Route("api/mods")] controller because both are
        // generated from the same Sample.Shared.IModsApi interface.
        _result = await ModsApi.GetMods();
    }
}
